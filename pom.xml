<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/>
	</parent>
	<groupId>com.mooc</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>backend</name>
	<description>Backend service</description>
	<properties>
		<java.version>17</java.version>
		<!-- 源码为 UTF-8（含中文注释与文本块），Windows 上 maven 默认用平台编码(GBK)读取会破坏文本块，必须显式声明 -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Windows 上 javac 默认用平台编码(GBK)读源文件，需显式指定 UTF-8，否则中文注释 / 文本块编译报错 -->
		<maven.compiler.encoding>UTF-8</maven.compiler.encoding>
		<jjwt.version>0.12.6</jjwt.version>
		<!-- Spring AI（change: add-travel-services）：1.1.x 是对应 Spring Boot 3.5.x 的线，
		     2.0.x 要求 Boot 4。升级前先确认 parent 版本，两者不能各自动。 -->
		<spring-ai.version>1.1.8</spring-ai.version>
		<!-- 与 Spring Boot 3.5 兼容的 springdoc 版本（本地仓库已缓存，可离线构建） -->
		<springdoc.version>2.8.8</springdoc.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<!-- Spring AI BOM：统一 spring-ai-* 与 io.modelcontextprotocol.sdk 的版本，
			     故下方 MCP starter 依赖不写 <version>（照 springdoc 之外的 BOM 惯例）。 -->
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- 真实邮件发送（SMTP）。未配置 spring.mail.host 时由 LoggingMailSender 接管，无需此依赖也能跑测试 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- 景点排行榜缓存（change: add-spot-ranking-redis-cache）：Lettuce 懒连接，Redis 不在线不影响启动 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<!-- OpenAPI 文档产出（change: openapi-integration）：/v3/api-docs + Swagger UI -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<!-- MCP Server（change: add-travel-services）：把旅行工具以 @Tool 暴露给模型。
		     选 webmvc 传输而非 webflux——本仓是 Spring MVC 栈，引入 webflux 会把两套 Web 运行时
		     同时放进 classpath。HTTP 传输默认关闭（见 application.yml 的 spring.ai.mcp.server），
		     工具由同进程的 ChatClient 直接消费。严禁为跑通 MCP 而在 SecurityConfig 放行其路径。 -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
		</dependency>
		<!-- Chat/Embedding 模型接入（change: ai-rag 切供）：OpenAI 兼容协议，经 base-url 指向
		     DashScope compatible-mode（qwen-plus / text-embedding-v3，真机 spike 2026-09-08 通过）。
		     api-key 为空时依赖自动配置须优雅跳过（fail-closed，spike 1.1 验证）——空 key 会致
		     context 启动失败，故 application.yml 已将六类 spring.ai.model.*=none 关 auto-config，
		     由 AiChatConfig（chat）与 RAG 自装 embedding 在 key 非空时显式自装配。 -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>
		<!-- 向量库（change: ai-rag-milvus，自 ai-rag 的 Chroma 切换）：Milvus 进程外服务（gRPC :19530），
		     spring-ai 官方 store 模块（内含 io.milvus SDK 传递依赖，勿单独声明）。
		     连接经惰性句柄，宕机只降级不崩；维度须显式（embeddingDimension，DashScope 1024 维）。 -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-milvus-store</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- 测试 JVM 固定禁用真实 SMTP：系统属性优先级高于环境变量，
					     即使开发者机器配置了 SPRING_MAIL_HOST（真实凭据）也不会让测试外发邮件。
					     "false" 是 MailSender 装配的既有哨兵值：SmtpMailSender 不装配，LoggingMailSender 接管。 -->
					<systemPropertyVariables>
						<spring.mail.host>false</spring.mail.host>
						<!-- 景点排行榜缓存（change: add-spot-ranking-redis-cache）：测试固定关闭，
						     避免共享 Redis 跨 @SpringBootTest 用例残留（@Transactional 不回滚 Redis 写入）。 -->
						<app.ranking-cache.enabled>false</app.ranking-cache.enabled>
						<!-- 旅行实用工具（change: add-travel-services）：测试固定关闭两个开关。
						     这里的语义比 ranking-cache 更强——关闭即「不出网」，保证任何
						     @SpringBootTest 都不会因为启动预热而真的去调 Frankfurter / OpenWeatherMap
						     （既烧配额，也让测试依赖外网）。需要启用路径的用例用 @TestPropertySource 覆盖。 -->
						<app.travel.exchange-rate.enabled>false</app.travel.exchange-rate.enabled>
						<app.travel.weather.enabled>false</app.travel.weather.enabled>
						<!-- AI 助手（change: ai-chat-core）：测试固定禁能，避免任何测试装配真实模型调用。
						     需要装配行为的用例用 @TestPropertySource 显式覆盖。 -->
						<app.ai-chat.enabled>false</app.ai-chat.enabled>
						<!-- AI 助手 RAG（change: ai-rag，向量库现为 Milvus）：测试固定禁能，避免任何测试
						     装配 embedding / 向量库（零出网、零向量库）。装配类用例用 @TestPropertySource 显式覆盖。 -->
						<app.ai-rag.enabled>false</app.ai-rag.enabled>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- 显式钉死编译器级别为 17：否则 maven-compiler-plugin 3.14.x 会退回默认 source/target 1.8，
					 导致 Java 17 文本块(""")编译失败（"未结束的字符串文字"）。java.version 仅设 release 属性，
					 在此插件版本下未真正生效，故此处显式声明。 -->
					<release>17</release>
					<encoding>UTF-8</encoding>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>